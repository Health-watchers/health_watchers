#!/bin/sh
# Run lint-staged (ESLint + Prettier on staged files)
# lint-staged is configured via .lintstagedrc.json which points at the
# consolidated flat ESLint config in packages/config/eslint-config/.
npx lint-staged

# Run secret scanning on staged files
. "$(dirname "$0")/pre-commit-secrets"

# Run actionlint on staged workflow files
. "$(dirname "$0")/pre-commit-actionlint"

# Run translation check on staged translation files
. "$(dirname "$0")/pre-commit-translations"

# Run license check on staged package.json files
. "$(dirname "$0")/pre-commit-licenses"