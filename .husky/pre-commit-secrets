#!/bin/sh
# =============================================================================
# pre-commit-secrets  — Scan staged files for secrets before committing
# Issue #926: Secrets Scanning
# =============================================================================
#
# Strategy:
#   1. If gitleaks is available, use it (most accurate, config-driven).
#   2. Otherwise, fall back to regex pattern matching on the staged diff.
#
# Install gitleaks (optional but recommended):
#   macOS:   brew install gitleaks
#   Linux:   https://github.com/gitleaks/gitleaks/releases
#   Docker:  docker run --rm -v "$(pwd):/repo" ghcr.io/gitleaks/gitleaks:latest detect --no-git

REPO_ROOT=$(git rev-parse --show-toplevel)
staged_files=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$staged_files" ]; then
  exit 0
fi

# ---------------------------------------------------------------------------
# Option A: gitleaks (preferred)
# ---------------------------------------------------------------------------
if command -v gitleaks > /dev/null 2>&1; then
  echo "🔍 Running gitleaks on staged files..."

  # Write a temp file list for gitleaks protect
  GITLEAKS_CONFIG="$REPO_ROOT/.gitleaks.toml"

  if [ -f "$GITLEAKS_CONFIG" ]; then
    gitleaks protect --staged --config="$GITLEAKS_CONFIG" --redact 2>&1
  else
    gitleaks protect --staged --redact 2>&1
  fi

  EXIT_CODE=$?

  if [ $EXIT_CODE -ne 0 ]; then
    echo ""
    echo "❌ Gitleaks detected potential secrets in staged files."
    echo "   Review the output above, remove or rotate the secret, then re-commit."
    echo "   If this is a false positive, add a 'gitleaks:allow' comment or update .gitleaks.toml."
    echo "   To bypass (NOT recommended): git commit --no-verify"
    exit 1
  fi

  echo "✅ Gitleaks: no secrets detected."
  exit 0
fi

# ---------------------------------------------------------------------------
# Option B: Regex pattern fallback (no gitleaks installed)
# ---------------------------------------------------------------------------
echo "⚠️  gitleaks not found — falling back to regex secret scanning."
echo "   For more accurate scanning, install gitleaks: https://github.com/gitleaks/gitleaks"

found=0

for file in $staged_files; do
  # Skip binary / lock files
  case "$file" in
    *.lock|package-lock.json|*.png|*.jpg|*.jpeg|*.gif|*.ico|*.woff|*.woff2|*.ttf|*.eot|*.svg|*.bin)
      continue
      ;;
    # Skip example / test files
    *.env.example|*.env.example.save)
      continue
      ;;
  esac

  # Don't scan test fixtures for secrets
  case "$file" in
    */__tests__/*|*/__mocks__/*|*/__fixtures__/*|*.test.ts|*.test.js|*.spec.ts|*.spec.js|*/factories/*)
      continue
      ;;
  esac

  staged_diff=$(git diff --cached -- "$file")

  if echo "$staged_diff" | grep -qE \
    "AKIA[0-9A-Z]{16}|\
-----BEGIN (RSA|EC|DSA|OPENSSH) PRIVATE KEY-----|\
ghp_[0-9a-zA-Z]{36}|\
github_pat_[0-9a-zA-Z_]{82}|\
sk-[a-zA-Z0-9]{48}|\
xox[baprs]-[0-9a-zA-Z\-]{10,}|\
S[A-Z2-7]{55}|\
AIza[0-9A-Za-z\-_]{35}|\
[Pp]assword\s*=\s*['\"][^'\"]{8,}['\"]|\
[Ss]ecret\s*=\s*['\"][^'\"]{8,}['\"]|\
[Aa][Pp][Ii][_-]?[Kk][Ee][Yy]\s*=\s*['\"][^'\"]{8,}['\"]|\
mongodb(\+srv)?://[^:]+:[^@]+@(?!localhost|127\.0\.0\.1)"; then
    echo "❌ Potential secret detected in: $file"
    found=1
  fi
done

if [ "$found" -eq 1 ]; then
  echo ""
  echo "Commit blocked. Remove or rotate secrets before committing."
  echo "To bypass (NOT recommended): git commit --no-verify"
  exit 1
fi

echo "✅ No secrets detected in staged files."
