# CDN Configuration for Static Asset Serving
# Copy this to your environment files and fill in with your actual CDN settings

# CDN Provider URL (e.g., https://cdn.example.com or https://d123.cloudfront.net)
NEXT_PUBLIC_CDN_URL=https://cdn.example.com

# CDN Provider Type (cloudflare, cloudfront, fastly, or custom)
NEXT_PUBLIC_CDN_PROVIDER=cloudflare

# CDN API Configuration
CDN_API_KEY=your_cdn_api_key_here

# Cloudflare Configuration (if using Cloudflare CDN)
CLOUDFLARE_ZONE_ID=your_zone_id_here
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# CloudFront Configuration (if using AWS CloudFront)
CLOUDFRONT_DISTRIBUTION_ID=your_distribution_id_here
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Fastly Configuration (if using Fastly)
FASTLY_SERVICE_ID=your_service_id_here
FASTLY_API_KEY=your_fastly_api_key_here

# Cache Configuration
CDN_CACHE_MAX_AGE=31536000  # 1 year for immutable assets
CDN_STALE_WHILE_REVALIDATE=86400  # 1 day

# Application Version for cache busting
NEXT_PUBLIC_APP_VERSION=1.0.0

# Enable CDN Monitoring
ENABLE_CDN_MONITORING=true
CDN_MONITORING_INTERVAL=3600  # Every hour in seconds
