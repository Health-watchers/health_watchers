{
  "index_patterns": ["health-watchers-*"],
  "priority": 100,
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 1,
        "number_of_replicas": 0,
        "refresh_interval": "30s",
        "max_result_window": 50000,
        "lifecycle": {
          "name": "health-watchers-policy",
          "rollover_alias": "health-watchers-write"
        }
      }
    },
    "mappings": {
      "dynamic": "false",
      "properties": {
        "@timestamp": {
          "type": "date",
          "format": "strict_date_optional_time||epoch_millis"
        },
        "timestamp": {
          "type": "date",
          "format": "strict_date_optional_time||epoch_millis"
        },
        "log_level": { "type": "keyword" },
        "message": {
          "type": "text",
          "analyzer": "standard",
          "fields": {
            "keyword": { "type": "keyword", "ignore_above": 1024 }
          }
        },
        "service": { "type": "keyword" },
        "environment": { "type": "keyword" },
        "cluster": { "type": "keyword" },
        "request_id": { "type": "keyword" },
        "trace_id": { "type": "keyword" },
        "span_id": { "type": "keyword" },
        "user_id": { "type": "keyword" },
        "clinic_id": { "type": "keyword" },
        "http_method": { "type": "keyword" },
        "http_path": {
          "type": "text",
          "fields": { "keyword": { "type": "keyword", "ignore_above": 512 } }
        },
        "http_status": { "type": "short" },
        "response_time_ms": { "type": "long" },
        "response_time_bucket": { "type": "keyword" },
        "error_message": { "type": "text" },
        "error_type": { "type": "keyword" },
        "stack_trace": { "type": "text", "index": false },
        "is_error": { "type": "boolean" },
        "source_ip": { "type": "ip" },
        "user_agent": { "type": "keyword" },
        "geoip": {
          "type": "object",
          "properties": {
            "location": { "type": "geo_point" },
            "country_code2": { "type": "keyword" },
            "city_name": { "type": "keyword" }
          }
        },
        "audit_action": { "type": "keyword" },
        "audit_resource": { "type": "keyword" },
        "audit_outcome": { "type": "keyword" }
      }
    }
  }
}
