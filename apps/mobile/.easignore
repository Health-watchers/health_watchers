# EAS Ignore - files to exclude from EAS builds

# Development
node_modules/
.expo/
.expo-shared/

# Environment files (use EAS Secrets instead)
.env
.env.*

# Tests
__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
coverage/

# Documentation
*.md
docs/

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Service account keys (should be in GitHub Secrets)
google-play-service-account.json
