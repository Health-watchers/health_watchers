# Base URL for backend API (change in production/staging)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Bundle analysis: set to "true" to generate a bundle visualization with @next/bundle-analyzer
# ANALYZE=true

# Bundle size budget (in kilobytes) enforced at build time; builds fail if exceeded
# NEXT_PUBLIC_BUNDLE_SIZE_BUDGET_KB=250

# API request timeout in milliseconds (overrides default)
# NEXT_PUBLIC_API_TIMEOUT_MS=30000

# Number of retry attempts for failed API requests (overrides default)
# NEXT_PUBLIC_API_RETRY_COUNT=3

# Batch size limit for bulk operations (overrides default)
# NEXT_PUBLIC_BATCH_SIZE_LIMIT=100