{
  "name": "health-watchers-monorepo",
  "private": true,
  "workspaces": [
    "apps/api",
    "packages/config",
    "packages/types",
    "packages/anonymize"
  ],
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@mermaid-js/mermaid-cli": "^10.9.1",
    "husky": "^9.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "latest"
  },
  "scripts": {
    "prepare": "husky",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:diagrams": "mkdir -p docs/diagrams/export && for f in docs/diagrams/*.mmd; do mmdc -i \"$f\" -o \"docs/diagrams/export/$(basename \"$f\" .mmd).svg\"; done",
    "audit:secrets": "ts-node scripts/audit-secrets.ts",
    "audit:secrets:staged": "ts-node scripts/audit-secrets.ts -- --mode=staged",
    "audit:secrets:full": "ts-node scripts/audit-secrets.ts -- --mode=full",
    "audit:secrets:since-main": "ts-node scripts/audit-secrets.ts -- --mode=commits",
    "setup:hooks": "bash scripts/setup-git-hooks.sh",
    "security:scan": "bash scripts/scan-dependencies.sh",
    "security:track": "node scripts/track-vulnerabilities.js update",
    "security:report": "node scripts/track-vulnerabilities.js report",
    "security:full": "npm run security:scan && npm run security:track && npm run security:report"
  },
  "overrides": {
    "ip": "^2.0.1",
    "semver": "^7.5.4",
    "word-wrap": "^1.2.4",
    "tough-cookie": "^4.1.3",
    "@babel/traverse": "^7.23.2",
    "axios": "^1.6.0",
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "ws": "^8.17.1",
    "path-to-regexp": "^0.1.12",
    "cookie": "^0.7.0",
    "cross-spawn": "^7.0.6",
    "nanoid": "^3.3.8",
    "tar": "^6.2.1",
    "node-fetch": "^2.7.0",
    "jsonwebtoken": "^9.0.0"
  }
}
