{
  "name": "health-watchers-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "husky": "^9.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "latest"
  },
  "scripts": {
    "prepare": "husky",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:secrets": "ts-node scripts/audit-secrets.ts",
    "audit:secrets:staged": "ts-node scripts/audit-secrets.ts -- --mode=staged",
    "audit:secrets:full": "ts-node scripts/audit-secrets.ts -- --mode=full",
    "audit:secrets:since-main": "ts-node scripts/audit-secrets.ts -- --mode=commits",
    "setup:hooks": "bash scripts/setup-git-hooks.sh"
  }
}
